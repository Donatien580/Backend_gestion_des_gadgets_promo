<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BordereauDotation" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<style name="tableHeader" mode="Opaque" backcolor="#0033A0" forecolor="#FFFFFF" hTextAlign="Center" vTextAlign="Middle" fontSize="10" isBold="true">
		<box padding="2"><pen lineWidth="1.0" lineColor="#000000"/></box>
	</style>
	<style name="cellule" mode="Opaque" backcolor="#FFFFFF" vTextAlign="Top" fontSize="10">
		<box padding="2"><pen lineWidth="1.0" lineColor="#000000"/></box>
	</style>
	<style name="tableTotal" mode="Transparent" vTextAlign="Middle" fontSize="10" isBold="true">
		<box padding="2"><pen lineWidth="1.5" lineColor="#000000"/></box>
	</style>
	<parameter name="numeroBordereau" class="java.lang.String"/>
	<parameter name="dateEnvoi" class="java.util.Date"/>
	<parameter name="structureBeneficiaire" class="java.lang.String"/>
	<parameter name="receptionniste" class="java.lang.String"/>
	<parameter name="totalBeneficiaires" class="java.lang.Integer"/>
	<parameter name="totalGadgets" class="java.lang.Integer"/>
	<parameter name="afficherBlocChefs" class="java.lang.Boolean"/>
        <parameter name="titreBlocSignataires" class="java.lang.String"/>
	<parameter name="logoStream" class="java.io.InputStream"/>
	<parameter name="sousRapportArticles" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="sousRapportSignataires" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="signatairesDataSource" class="net.sf.jasperreports.engine.JRDataSource"/>
	<field name="categorie" class="java.lang.String"/>
	<field name="nombre" class="java.lang.Integer"/>
	<field name="articles" class="java.util.Collection"/>
	<title>
		<band height="172">
			<image>
				<reportElement x="0" y="0" width="80" height="80"/>
				<imageExpression><![CDATA[$P{logoStream}]]></imageExpression>
			</image>
			<staticText>
				<reportElement x="100" y="0" width="455" height="16"/>
				<textElement textAlignment="Center"><font size="11" isBold="true"/></textElement>
				<text><![CDATA[SOCIETE NATIONALE D'ELECTRICITE DU BURKINA (SONABEL)]]></text>
			</staticText>
			<staticText>
				<reportElement x="100" y="16" width="455" height="14"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[DIRECTION GENERALE]]></text>
			</staticText>
			<staticText>
				<reportElement x="100" y="30" width="455" height="14"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[SECRETARIAT GENERAL]]></text>
			</staticText>
			<staticText>
				<reportElement x="100" y="44" width="455" height="14"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[POLE DISTRIBUTION ET COMMERCIALISATION]]></text>
			</staticText>
			<staticText>
				<reportElement x="100" y="58" width="455" height="14"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[DIRECTION COMMERCIALE ET MARKETING]]></text>
			</staticText>
			<staticText>
				<reportElement x="100" y="72" width="455" height="14"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[DEPARTEMENT MARKETING ET INNOVATIONS]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="90" width="555" height="1"/>
			</line>
			<staticText>
				<reportElement mode="Opaque" x="0" y="100" width="555" height="20" forecolor="#FFFFFF" backcolor="#0033A0"/>
				<textElement textAlignment="Center"><font size="14" isBold="true"/></textElement>
				<text><![CDATA[BORDEREAU DE LIVRAISON]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement x="0" y="130" width="400" height="15"/>
				<textFieldExpression><![CDATA["N/Ref : " + $P{numeroBordereau} + "/DG/SG/PDC/DCM/DMI/TB/AK"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="400" y="130" width="155" height="15"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA["Date : " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{dateEnvoi})]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="0" y="148" width="555" height="15">
					<printWhenExpression><![CDATA[$P{structureBeneficiaire} != null && !$P{structureBeneficiaire}.trim().isEmpty()]]></printWhenExpression>
				</reportElement>
				<textElement><font isBold="true"/></textElement>
				<textFieldExpression><![CDATA["Direction / structure bénéficiaire : " + $P{structureBeneficiaire}]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<columnHeader>
		<band height="22">
			<staticText>
				<reportElement style="tableHeader" x="0" y="0" width="120" height="22"/>
				<text><![CDATA[Chefs]]></text>
			</staticText>
			<staticText>
				<reportElement style="tableHeader" x="120" y="0" width="55" height="22"/>
				<text><![CDATA[Nombre]]></text>
			</staticText>
			<staticText>
				<reportElement style="tableHeader" x="175" y="0" width="220" height="22"/>
				<text><![CDATA[Articles (gadgets)]]></text>
			</staticText>
			<staticText>
				<reportElement style="tableHeader" x="395" y="0" width="75" height="22"/>
				<text><![CDATA[Quantité]]></text>
			</staticText>
			<staticText>
				<reportElement style="tableHeader" x="470" y="0" width="85" height="22"/>
				<text><![CDATA[Quantité totale]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="22">
			<textField isStretchWithOverflow="true">
				<reportElement style="cellule" stretchType="RelativeToBandHeight" x="0" y="0" width="120" height="22"/>
				<textElement><font isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{categorie}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement style="cellule" stretchType="RelativeToBandHeight" x="120" y="0" width="55" height="22"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
			</textField>
			<subreport>
				<reportElement x="175" y="0" width="380" height="22"/>
				<dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($F{articles})]]></dataSourceExpression>
				<subreportExpression><![CDATA[$P{sousRapportArticles}]]></subreportExpression>
			</subreport>
		</band>
	</detail>
	<summary>
		<band height="190">
			<staticText>
				<reportElement style="tableTotal" x="0" y="0" width="120" height="22"/>
				<text><![CDATA[Total]]></text>
			</staticText>
			<textField>
				<reportElement style="tableTotal" x="120" y="0" width="55" height="22"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$P{totalBeneficiaires}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="tableTotal" x="175" y="0" width="220" height="22"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[-]]></text>
			</staticText>
			<staticText>
				<reportElement style="tableTotal" x="395" y="0" width="75" height="22"/>
				<text><![CDATA[]]></text>
			</staticText>
			<textField>
				<reportElement style="tableTotal" x="470" y="0" width="85" height="22"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$P{totalGadgets}]]></textFieldExpression>
			</textField>

			<!-- Noms des chefs : une ligne par chef -->
			<textField>
	<reportElement positionType="Float" x="0" y="45" width="360" height="16">
		<printWhenExpression><![CDATA[$P{afficherBlocChefs}]]></printWhenExpression>
	</reportElement>
	<textElement><font isBold="true" isUnderline="true"/></textElement>
	<textFieldExpression><![CDATA[$P{titreBlocSignataires}]]></textFieldExpression>
                        </textField>
			<staticText>
				<reportElement positionType="Float" x="380" y="45" width="175" height="16">
					<printWhenExpression><![CDATA[$P{afficherBlocChefs}]]></printWhenExpression>
				</reportElement>
				<textElement><font isBold="true" isUnderline="true"/></textElement>
				<text><![CDATA[Signature]]></text>
			</staticText>
			<subreport>
				<reportElement positionType="Float" x="0" y="64" width="555" height="22">
					<printWhenExpression><![CDATA[$P{afficherBlocChefs}]]></printWhenExpression>
				</reportElement>
				<dataSourceExpression><![CDATA[$P{signatairesDataSource}]]></dataSourceExpression>
				<subreportExpression><![CDATA[$P{sousRapportSignataires}]]></subreportExpression>
			</subreport>

			<!-- Personne réceptionniste -->
			<staticText>
				<reportElement positionType="Float" x="0" y="110" width="360" height="16"/>
				<textElement><font isBold="true" isUnderline="true"/></textElement>
				<text><![CDATA[Noms de la personne réceptionniste :]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="380" y="110" width="175" height="16"/>
				<textElement><font isBold="true" isUnderline="true"/></textElement>
				<text><![CDATA[Signature]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="0" y="132" width="360" height="18"/>
				<textFieldExpression><![CDATA[($P{receptionniste} == null || $P{receptionniste}.trim().isEmpty()) ? "............................................................" : $P{receptionniste}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="380" y="132" width="175" height="18"/>
				<text><![CDATA[.............................................]]></text>
			</staticText>
		</band>
	</summary>
</jasperReport>